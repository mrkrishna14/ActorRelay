# Copy values into your shell or an ignored .env file. No secret values belong here.
GLUE_MODE=mock
HOST=127.0.0.1
PORT=7200
CORS_ORIGIN=http://localhost:3000
# Live mode requires Person 1's actor port. ACTOR_CLIENT_MODULE takes priority over ACTOR_API_URL. See HANDOFF.md for the /rpc contract.
ACTOR_CLIENT_MODULE=
ACTOR_API_URL=http://127.0.0.1:7100
ACTOR_API_TOKEN=
# Required in live mode: POST /execute-callback must send "Authorization: Bearer <value>". Unset means every callback gets 401.
EXECUTION_CALLBACK_TOKEN=
# Set RELAY_WORKSPACE_KEY to register, or RELAY_AGENT_TOKEN to reconnect. A registered token is also kept in the journal.
RELAY_WORKSPACE_KEY=
RELAY_AGENT_TOKEN=
RELAY_BASE_URL=
RELAY_SYSTEM_NAME=actorrelay-system
SIM_URL=http://127.0.0.1:7300
# Live mode only: glue polls the simulation into actors every GLUE_TICK_MS unless the bridge pushes /mirror (set to 1 or true).
BRIDGE_PUSHES_MIRROR=
GLUE_TICK_MS=1000
# SQLite file holding the command journal, Relay outbox, and Relay agent token. Keep it across restarts and out of git.
GLUE_JOURNAL_PATH=.runtime/glue.sqlite
