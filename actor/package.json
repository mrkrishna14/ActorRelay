{
    "name": "actorrelay-actor",
    "private": true,
    "type": "module",
    "engines": {
        "bun": ">=1.4.2"
    },
    "scripts": {
        "dev": "terse actor dev",
        "check": "tsc --noEmit",
        "test": "bun run generate && bun test tests --timeout 60000",
        "deploy": "bun scripts/deploy.ts",
        "generate": "cd client && terse actor generate --language typescript --non-interactive",
        "sync-types": "cp ../shared/types.ts src/types.ts"
    },
    "dependencies": {
        "terse-sdk": "0.14.9",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@types/node": "^22.0.0",
        "typescript": "~5.9.3"
    },
    "trustedDependencies": [
        "esbuild"
    ]
}
